{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Códigos estables: el cliente programa contra ellos, no contra el texto.",
        "enum": [
          "invalid_json",
          "validation_error",
          "not_found",
          "method_not_allowed",
          "http_error",
          "model_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Descripción estable del error.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo presente en errores de validación.",
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Sobre común de todas las respuestas de error (contrato de S7).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "Un campo del cuerpo que incumple el contrato.",
        "properties": {
          "field": {
            "examples": [
              "features.alcohol"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be a valid number"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y del modelo cargado.",
        "properties": {
          "model_status": {
            "const": "ready",
            "title": "Model Status",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "model_status",
          "model_version",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Prediction": {
        "description": "Predicción pública: no incluye puntuaciones internas del modelo.",
        "properties": {
          "confidence": {
            "description": "Confianza del modelo entre 0 y 1.",
            "title": "Confidence",
            "type": "number"
          },
          "model_version": {
            "description": "Versión del modelo",
            "title": "Model Version",
            "type": "string"
          },
          "preprocessing_version": {
            "description": "Versión del preprocesado",
            "title": "Preprocessing Version",
            "type": "string"
          },
          "quality_band": {
            "$ref": "#/components/schemas/QualityBand",
            "description": "Banda de calidad estimada."
          }
        },
        "required": [
          "quality_band",
          "confidence",
          "model_version",
          "preprocessing_version"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "description": "Cuerpo de `POST /v1/predictions`.",
        "properties": {
          "features": {
            "$ref": "#/components/schemas/WineFeatures"
          }
        },
        "required": [
          "features"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Respuesta de `POST /v1/predictions`.",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "served_at": {
            "format": "date-time",
            "title": "Served At",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "request_id"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "QualityBand": {
        "description": "Bandas de calidad que entiende el consumidor.",
        "enum": [
          "needs_review",
          "acceptable",
          "excellent"
        ],
        "title": "QualityBand",
        "type": "string"
      },
      "WineFeatures": {
        "additionalProperties": false,
        "description": "Once variables fisicoquímicas de un vino tinto, con rangos inclusivos.",
        "properties": {
          "alcohol": {
            "description": "Alcohol (% vol.).",
            "maximum": 20.0,
            "minimum": 5.0,
            "title": "Alcohol",
            "type": "number"
          },
          "chlorides": {
            "description": "Cloruros (g/dm³).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Chlorides",
            "type": "number"
          },
          "citric_acid": {
            "description": "Ácido cítrico (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Citric Acid",
            "type": "number"
          },
          "density": {
            "description": "Densidad (g/cm³).",
            "maximum": 1.01,
            "minimum": 0.98,
            "title": "Density",
            "type": "number"
          },
          "fixed_acidity": {
            "description": "Acidez fija (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Fixed Acidity",
            "type": "number"
          },
          "free_sulfur_dioxide": {
            "description": "Dióxido de azufre libre (mg/dm³).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Free Sulfur Dioxide",
            "type": "number"
          },
          "ph": {
            "description": "pH (adimensional).",
            "maximum": 4.5,
            "minimum": 2.5,
            "title": "Ph",
            "type": "number"
          },
          "residual_sugar": {
            "description": "Azúcar residual (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Residual Sugar",
            "type": "number"
          },
          "sulphates": {
            "description": "Sulfatos (g/dm³).",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Sulphates",
            "type": "number"
          },
          "total_sulfur_dioxide": {
            "description": "Dióxido de azufre total (mg/dm³).",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Total Sulfur Dioxide",
            "type": "number"
          },
          "volatile_acidity": {
            "description": "Acidez volátil (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Volatile Acidity",
            "type": "number"
          }
        },
        "required": [
          "fixed_acidity",
          "volatile_acidity",
          "citric_acid",
          "residual_sugar",
          "chlorides",
          "free_sulfur_dioxide",
          "total_sulfur_dioxide",
          "density",
          "ph",
          "sulphates",
          "alcohol"
        ],
        "title": "WineFeatures",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nServicio de inferencia que estima la banda de calidad de un vino tinto a partir\nde once variables fisicoquímicas.\n\n## request_id\n\nCada respuesta incluye un `request_id` que coincide con la cabecera\n`X-Request-Id`. Cítalo al reportar una incidencia: permite localizar la\npetición en los logs.\n\n## Errores\n\nTodos los errores comparten el mismo sobre:\n\n```json\n{\n  \"error\": {\"code\": \"validation_error\", \"message\": \"...\", \"fields\": [...]},\n  \"request_id\": \"req_...\"\n}\n```\n\nPrograma contra `error.code`, que es estable; `message` es orientativo y\n`fields` solo aparece en errores de validación.\n",
    "summary": "Predicción de la banda de calidad de vinos tintos.",
    "title": "Wine Quality API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Indica si el servicio puede atender predicciones.\n\nÚsalo como sonda de disponibilidad (readiness) antes de enviar tráfico.\nUn `200` significa que el modelo está cargado; un `503` significa que el\nproceso responde pero el modelo no está listo, así que conviene reintentar\nmás tarde en lugar de llamar a `POST /v1/predictions`.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "El servicio está activo y el modelo listo para predecir."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está cargado (`model_unavailable`): el servicio está vivo pero no puede predecir."
          }
        },
        "summary": "Comprobar el estado del servicio",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "description": "Estima la banda de calidad de un vino tinto a partir de once variables.\n\n- Todas las variables de `features` son obligatorias, numéricas y con rangos\n  inclusivos; los campos desconocidos se rechazan con `422`.\n- `prediction.confidence` está entre 0 y 1 y se expone con dos decimales.\n- `served_at` es la hora de servicio en UTC (ISO 8601 con sufijo `Z`).\n- `request_id` coincide con la cabecera `X-Request-Id`: cítalo al reportar\n  una incidencia.",
        "operationId": "create_prediction_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "missing_and_extra": {
                  "description": "Sin `ph` y con un campo desconocido `color`: responde 422 con un error por campo.",
                  "summary": "Inválido: falta un campo y sobra otro",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "color": "red",
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "out_of_range": {
                  "description": "`alcohol` debe estar entre 5 y 20: responde 422.",
                  "summary": "Inválido: alcohol fuera de rango",
                  "value": {
                    "features": {
                      "alcohol": 25.0,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "valid": {
                  "description": "Las once variables dentro de rango: responde 200.",
                  "summary": "Vino tinto válido",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "wrong_type": {
                  "description": "Los campos son numéricos y estrictos: `\"9.4\"` responde 422.",
                  "summary": "Inválido: texto en lugar de número",
                  "value": {
                    "features": {
                      "alcohol": "9.4",
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Predicción pública con trazabilidad del modelo."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El cuerpo no es JSON válido (`invalid_json`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El JSON no cumple el contrato (`validation_error`); `error.fields` indica qué campos fallan."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está disponible (`model_unavailable`)."
          }
        },
        "summary": "Predecir la banda de calidad de un vino tinto",
        "tags": [
          "predictions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Estado del servicio y del modelo cargado.",
      "name": "health"
    },
    {
      "description": "Predicción de la banda de calidad de un vino tinto.",
      "name": "predictions"
    }
  ]
}
